{
  "name": "cipher-portfolio",
  "version": "4.1.0",
  "private": false,
  "description": "Official portfolio website for Cipher Unit — an open-source engineering collective building secure, scalable developer tools.",
  "license": "MIT",
  "author": {
    "name": "Cipher Unit",
    "email": "cipherunit.dev@gmail.com",
    "url": "https://cipherunit.xyz"
  },
  "homepage": "https://cipherunit.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherunits/CipherPortfolio.git"
  },
  "bugs": {
    "url": "https://github.com/cipherunits/CipherPortfolio/issues"
  },
  "keywords": [
    "cipher-unit",
    "cipherunit",
    "portfolio",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "open-source",
    "developer-tools",
    "engineering-collective"
  ],
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.5.2",
  "sideEffects": false,
  "scripts": {
    "cipherscope": "cipher-scope banner",
    "dev": "next dev",
    "prebuild": "pnpm cipherscope && pnpm check",
    "build": "pnpm cipherscope && next build",
    "start": "pnpm cipherscope && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "clean": "rm -rf .next out dist node_modules/.cache",
    "seo:notify": "node scripts/seo-notify.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "cipher-scope": "^0.1.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "edge >= 111",
    "not dead"
  ]
}
